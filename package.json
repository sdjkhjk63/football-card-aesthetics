{
  "name": "football-card-aesthetics",
  "version": "0.1.0",
  "description": "A private multilingual football card design-rating desktop app.",
  "author": "Card Aesthetics",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:prepare": "install-electron",
    "desktop:dev": "pnpm desktop:prepare && pnpm desktop:build && electron .",
    "desktop:pack": "pnpm desktop:prepare && pnpm desktop:build && electron-builder --dir --win",
    "desktop:dist": "pnpm desktop:prepare && pnpm desktop:build && node scripts/build-desktop-installer.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "build": {
    "appId": "com.cardaesthetics.desktop",
    "productName": "Card Aesthetics",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Card Aesthetics Setup ${version}.${ext}"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Card Aesthetics",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
